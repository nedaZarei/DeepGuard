# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# DeepGuard runtime artifacts
.deepguard/

# User-specific config file (keep .deepguard.yaml.example)
.deepguard.yaml

# Scan output directory
reports/*
!reports/evaluation-metrics/
!reports/demo/

# Go workspace file
go.work

# Docker override file (user-specific)
docker-compose.override.yml

# Environment files
.env
.env.local

# Claude Code settings (IDE tooling, not part of the project)
.claude/

# CodeQL binary distribution (installed via brew or downloaded manually)
tools/codeql/
tools/codeql.zip
tools/codeql-bundle.tar.gz
