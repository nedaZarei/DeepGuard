# Deep-Guard Fix — 2026-07-10T20:08:02+03:30
# File: /tmp/dvna/core/appHandler.js  Line: 10  Severity: critical
# Type: crypto_issue

## Root Cause
The vulnerability is due to the use of unsafe string concatenation to construct a SQL query, which can lead to SQL injection attacks.

## Explanation
The patch replaces the string concatenation with a parameterized query that uses placeholders for user input. This ensures that any user input is treated as data rather than executable code, thereby mitigating the risk of SQL injection.

## Patch
--- a/tmp/dvna/core/appHandler.js
+++ b/tmp/dvna/core/appHandler.js
@@ -10,7 +10,7 @@
 var query = "SELECT name,id FROM Users WHERE login='" + req.body.login + "'";
-db.sequelize.query(query, {
+db.sequelize.query("SELECT name, id FROM Users WHERE login = :login", {
     replacements: { login: req.body.login },
     model: db.User
 }).then(user => {

