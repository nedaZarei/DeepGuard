# Deep-Guard Fix — 2026-07-10T20:07:02+03:30
# File: /tmp/dvna/core/appHandler.js  Line: 197  Severity: critical
# Type: command_injection

## Root Cause
The code directly evaluates user input without validation, leading to potential command injection vulnerabilities.

## Explanation
The patch adds input validation to ensure that only mathematical expressions are permitted before evaluation. By sanitizing the input, we reduce the risk of malicious commands or unintended code execution.

## Patch
--- a/tmp/dvna/core/appHandler.js
+++ b/tmp/dvna/core/appHandler.js
@@ -194,6 +194,9 @@
 
 module.exports.calc = function (req, res) {
     if (req.body.eqn) {
+        // Validate input to only allow safe mathematical expressions
+        const safePattern = /^[0-9()+\-*/\s]+$/;
+        if (!safePattern.test(req.body.eqn)) {
+            return res.render('app/calc', { output: 'Invalid mathematical expression.' });
+        }
         res.render('app/calc', {
             output: mathjs.eval(req.body.eqn)
         })
     } else {
         res.render('app/calc', {
             output: 'Enter a valid math string like (3+3)*2'
         })
     }
 }
